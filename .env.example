# ==============================================================================
# Google Colab Relay Supervisor - Render Environment Variables Configuration
# ==============================================================================
# In Render Dashboard -> Environment -> Environment Variables:
# Add the following keys (supports both raw text and base64 strings):
#
# 1. Colab OAuth Refresh Tokens (Accounts 1, 2, 3)
#    Can be raw JSON string {"client_id": ...} or base64 encoded token JSON.
#    COLAB_TOKEN_1=<Raw JSON or Base64 of account_1.json>
#    COLAB_TOKEN_2=<Raw JSON or Base64 of account_2.json>
#    COLAB_TOKEN_3=<Raw JSON or Base64 of account_3.json>
#
# 2. Google Drive / Rclone Configuration
#    Can be base64 encoded rclone.conf (recommended for multi-line INI) or raw text.
#    RCLONE_CONF_B64=<Base64 encoded rclone.conf>
#    # OR: RCLONE_CONF=<Raw INI text of rclone.conf>
#
# 3. Cloudflare Named Tunnel Token
#    TUNNEL_TOKEN=<Cloudflare tunnel token string>
#    # Alias supported: CLOUDFLARE_TUNNEL_TOKEN=<token>
#
# 4. Telegram Bot Supervisor & Mobile Remote Emergency Trigger
#    TG_BOT_TOKEN=<Telegram Bot Token from @BotFather>
#    TG_CHAT_ID=<Your Telegram Chat / Owner ID>
#
# 5. Operational Options (Optional)
#    STARTING_ACCOUNT=1       # 1, 2, or 3 (Defaults to 1)
#    PYTHON_VERSION=3.12.0    # Render Python buildpack version
# ==============================================================================
